# Application
APP_NAME=question-bank-kb
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
API_PREFIX=/api/v1

# Database
DATABASE_URL=postgresql+asyncpg://kushal:0000@localhost:5433/question_bank
DATABASE_ECHO=false

# Storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50

# Gemini (default providers)
GEMINI_API_KEY=

# Embedding
EMBEDDING_PROVIDER=gemini
EMBEDDING_DIMENSION=1536
EMBEDDING_MODEL=gemini-embedding-001

# LLM
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=2048

# Optional OpenAI-compatible providers
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Chunking
CHUNK_MIN_WORDS=500
CHUNK_MAX_WORDS=800

# Task queue
TASK_BACKEND=in_memory

# Search
HYBRID_KEYWORD_WEIGHT=0.3
HYBRID_SEMANTIC_WEIGHT=0.7
SEARCH_DEFAULT_LIMIT=10
