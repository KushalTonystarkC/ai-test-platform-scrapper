# Application
APP_NAME=question-bank-kb
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
API_PREFIX=/api/v1

# Database
DATABASE_URL=postgresql+asyncpg://kushal:0000@localhost:5433/question_bank
DATABASE_ECHO=false

# Storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50

# ---------------------------------------------------------------------------
# Default: free local open-source stack
#   Embeddings → sentence-transformers (BAAI/bge-small-en-v1.5, dim 384)
#   LLM        → Ollama (llama3.2) via OpenAI-compatible API
# ---------------------------------------------------------------------------

# Embedding (local, no API key)
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_DIMENSION=384
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# LLM via Ollama (install: https://ollama.com  then: ollama pull llama3.2)
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=300
OPENAI_API_KEY=ollama
OPENAI_BASE_URL=http://localhost:11434/v1

# Optional: Gemini (paid API) — set providers to gemini and fill key
GEMINI_API_KEY=

# Chunking
CHUNK_MIN_WORDS=500
CHUNK_MAX_WORDS=800

# Task queue
TASK_BACKEND=in_memory

# Search
HYBRID_KEYWORD_WEIGHT=0.3
HYBRID_SEMANTIC_WEIGHT=0.7
SEARCH_DEFAULT_LIMIT=10

# Frontend (Next.js on :3000)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
